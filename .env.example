# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./dev_assistant.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dev_assistant

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Cache Configuration
CACHE_TTL_SECONDS=3600
MAX_CACHE_SIZE=1000
